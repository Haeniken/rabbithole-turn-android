<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="315"
                android:centerColor="#CA8037D4"
                android:endColor="#BC4D169B"
                android:startColor="#D3C568F2" />
            <stroke android:width="1.5dp" android:color="#F3E7CCFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="315"
                android:centerColor="#B96E2DC0"
                android:endColor="#AD3D1288"
                android:startColor="#C7AD55EB" />
            <stroke android:width="1dp" android:color="#E6D7B2FF" />
        </shape>
    </item>
</selector>
