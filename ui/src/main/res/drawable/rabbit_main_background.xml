<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#05030A" />
        </shape>
    </item>
    <item>
        <bitmap
            android:antialias="true"
            android:filter="true"
            android:gravity="fill"
            android:src="@drawable/rabbit_rift_background" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#1209061A"
                android:endColor="#2705030B"
                android:startColor="#3805030B"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
