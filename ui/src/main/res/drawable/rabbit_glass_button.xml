<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="315"
                android:centerColor="#98452665"
                android:endColor="#86150C28"
                android:startColor="#A6502B77" />
            <stroke android:width="1dp" android:color="#D8C49BEF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="315"
                android:centerColor="#60321D4D"
                android:endColor="#4F0C0717"
                android:startColor="#72452666" />
            <stroke android:width="0.75dp" android:color="#A88861B7" />
        </shape>
    </item>
</selector>
