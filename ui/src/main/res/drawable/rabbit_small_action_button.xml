<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="315"
                android:endColor="#8D271242"
                android:startColor="#A75E3484" />
            <stroke android:width="1dp" android:color="#C9B98ADA" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="315"
                android:centerColor="#55331D4E"
                android:endColor="#460A0611"
                android:startColor="#69422760" />
            <stroke android:width="0.75dp" android:color="#7F785390" />
        </shape>
    </item>
</selector>
