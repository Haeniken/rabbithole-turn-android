<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient
                android:angle="315"
                android:centerColor="#A8462867"
                android:endColor="#94130A24"
                android:startColor="#B2572F82" />
            <stroke android:width="1dp" android:color="@color/rabbit_accent_soft" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient
                android:angle="315"
                android:centerColor="#66211337"
                android:endColor="#5707040D"
                android:startColor="#7B321A4D" />
            <stroke android:width="0.75dp" android:color="@color/rabbit_outline_glass" />
        </shape>
    </item>
</selector>
