<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="315" android:endColor="#B3190C2B" android:startColor="#C33D1C64" />
            <stroke android:width="1dp" android:color="@color/rabbit_accent_soft" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="315" android:endColor="#9606030D" android:startColor="#A91B0D2D" />
            <stroke android:width="0.75dp" android:color="#786A4A8E" />
        </shape>
    </item>
</selector>
