<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient
                android:angle="315"
                android:centerColor="#C27035B2"
                android:endColor="#B536126C"
                android:startColor="#CEC067E9" />
            <stroke android:width="1dp" android:color="#F0E2C6FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient
                android:angle="315"
                android:centerColor="#A4522389"
                android:endColor="#91210C4B"
                android:startColor="#B47E42B9" />
            <stroke android:width="1dp" android:color="@color/rabbit_accent_soft" />
        </shape>
    </item>
</selector>
