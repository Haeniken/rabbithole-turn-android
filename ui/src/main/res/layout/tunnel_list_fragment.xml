<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <import type="com.wireguard.android.backend.Tunnel.State" />
        <import type="com.wireguard.android.model.ObservableTunnel" />

        <variable name="fragment" type="com.wireguard.android.fragment.TunnelListFragment" />
        <variable name="heroTunnel" type="com.wireguard.android.model.ObservableTunnel" />
        <variable name="activeTunnel" type="com.wireguard.android.model.ObservableTunnel" />
        <variable
            name="rowConfigurationHandler"
            type="com.wireguard.android.databinding.ObservableKeyedRecyclerViewAdapter.RowConfigurationHandler" />
        <variable
            name="tunnels"
            type="com.wireguard.android.databinding.ObservableKeyedArrayList&lt;String, ObservableTunnel&gt;" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/rabbit_main_background"
        android:clipChildren="false">

        <com.wireguard.android.widget.DeepPortalBackgroundView
            android:id="@+id/portal_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            app:portalActive="@{activeTunnel != null &amp;&amp; activeTunnel.state == State.UP}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/main_screen_horizontal_padding"
            android:layout_marginTop="@dimen/main_header_top_margin"
            android:layout_marginEnd="@dimen/main_screen_horizontal_padding"
            android:minHeight="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/brand_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:text="@string/app_name"
                android:textColor="@color/rabbit_text_primary"
                android:textSize="@dimen/main_header_title_text_size"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/settings_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/settings_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:contentDescription="@string/settings"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/create_fab"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/rabbit_glass_button"
                    android:duplicateParentState="true">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_settings" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/create_fab"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:contentDescription="@string/create_tunnel"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:nextFocusUp="@id/tunnel_list"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/rabbit_accent_button"
                    android:duplicateParentState="true">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_action_add_white"
                        app:tint="@color/rabbit_text_primary" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/hero_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/main_screen_horizontal_padding"
            android:layout_marginTop="@dimen/main_section_margin"
            android:layout_marginEnd="@dimen/main_screen_horizontal_padding"
            android:clipChildren="false"
            android:minHeight="@dimen/main_hero_min_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/main_header">

            <com.wireguard.android.widget.PortalShelfView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/hero_copy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/main_hero_padding"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/main_power_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/hero_tunnel_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/exo2_semibold"
                    android:letterSpacing="0.045"
                    android:maxLines="3"
                    android:text="@{heroTunnel == null ? @string/main_no_tunnel : (activeTunnel != null &amp;&amp; activeTunnel.state == State.UP ? @string/main_connected : @string/main_ready)}"
                    android:textColor="@color/rabbit_text_primary"
                    android:textSize="@dimen/main_hero_title_text_size"
                    tools:text="ПРЫЖОК В НОРУ" />

                <TextView
                    android:id="@+id/hero_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/exo2_semibold_italic"
                    android:maxLines="3"
                    android:text="@string/main_ready_hint"
                    android:textColor="@color/rabbit_text_secondary"
                    android:textSize="@dimen/main_hero_status_text_size"
                    android:textStyle="italic"
                    android:visibility="@{heroTunnel != null &amp;&amp; (activeTunnel == null || activeTunnel.state != State.UP) ? View.VISIBLE : View.GONE}"
                    tools:text="Следуем за белым кроликом…"
                    tools:visibility="visible" />
            </LinearLayout>

            <com.wireguard.android.widget.PrismaticPowerView
                android:id="@+id/main_power_button"
                android:layout_width="@dimen/main_power_size"
                android:layout_height="@dimen/main_power_size"
                android:layout_marginEnd="@dimen/main_power_end_margin"
                android:activated="@{activeTunnel != null &amp;&amp; activeTunnel.state == State.UP}"
                android:clickable="true"
                android:contentDescription="@string/main_toggle_tunnel"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/actions_strip"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="@dimen/main_screen_horizontal_padding"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="@dimen/main_screen_horizontal_padding"
            android:paddingStart="5dp"
            android:paddingEnd="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hero_card">

            <ImageView
                android:id="@+id/signal_trace"
                android:layout_width="76dp"
                android:layout_height="18dp"
                android:alpha="0.7"
                android:contentDescription="@null"
                android:src="@drawable/rabbit_signal_trace"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/latency_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/rabbit_accent_soft"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/signal_trace"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="42 ms"
                tools:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/subscription_refresh"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:contentDescription="@string/subscription_update"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/rabbit_small_action_button"
                    android:duplicateParentState="true">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/subscription_refresh_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_refresh"
                        app:tint="@color/rabbit_accent_soft" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/latency_check"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="7dp"
                android:clickable="true"
                android:contentDescription="@string/latency_check"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/subscription_refresh"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/rabbit_small_action_button"
                    android:duplicateParentState="true">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/latency_icon"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_latency"
                        app:tint="@color/rabbit_text_secondary" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tunnels_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/main_screen_horizontal_padding"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/main_screen_horizontal_padding"
            android:layout_marginBottom="@dimen/main_screen_bottom_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/actions_strip">

            <TextView
                android:id="@+id/connections_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="@string/main_connections"
                android:textAllCaps="true"
                android:textColor="@color/rabbit_text_secondary"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/card_divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/rabbit_accent_divider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/subscription_summary" />

            <LinearLayout
                android:id="@+id/subscription_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="5dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/connections_title"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/subscription_summary_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/rabbit_text_primary"
                    android:textSize="13sp"
                    tools:text="haeniken" />

                <TextView
                    android:id="@+id/subscription_summary_expiry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/rabbit_text_secondary"
                    android:textSize="11sp"
                    tools:text="Действует до 30.01.2100" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tunnel_list"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:nextFocusDown="@id/create_fab"
                android:nextFocusForward="@id/create_fab"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="@{tunnels.size() > 0 ? View.VISIBLE : View.GONE}"
                app:configurationHandler="@{rowConfigurationHandler}"
                app:items="@{tunnels}"
                app:layout="@{@layout/tunnel_list_item}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_divider"
                tools:itemCount="4"
                tools:listitem="@layout/tunnel_list_item" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="@{tunnels.size() == 0 ? View.VISIBLE : View.GONE}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_divider"
                tools:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:alpha="0.72"
                    android:contentDescription="@null"
                    android:src="@mipmap/ic_launcher_round" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/tunnel_list_placeholder"
                    android:textColor="@color/rabbit_text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
